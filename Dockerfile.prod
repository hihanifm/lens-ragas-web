# ── Stage 1: build frontend ───────────────────────────────────────────────────
FROM node:20-alpine AS frontend-build

# Proxy build args — passed from docker-compose, empty if not set in .env
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY

WORKDIR /frontend

# Install lab CA cert — append directly, no apk add needed.
COPY certs/ /tmp/certs/
RUN if ls /tmp/certs/*.crt 2>/dev/null 1>&2; then \
      cat /tmp/certs/*.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi && rm -rf /tmp/certs

ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Trust the registry host at build time, re-enable strict SSL after install.
RUN npm config set strict-ssl false
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
RUN npm config set strict-ssl true

COPY frontend/ ./
ARG VITE_BASE_PATH=/
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build


# ── Stage 2: Python runtime ───────────────────────────────────────────────────
FROM python:3.11-slim AS app

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=$HTTP_PROXY \
    HTTPS_PROXY=$HTTPS_PROXY \
    NO_PROXY=$NO_PROXY

WORKDIR /app

# Install lab CA cert if present (safe no-op when certs/ is empty).
COPY certs/ /tmp/certs/
RUN if ls /tmp/certs/*.crt 2>/dev/null 1>&2; then \
      cp /tmp/certs/*.crt /usr/local/share/ca-certificates/ && \
      update-ca-certificates; \
    fi && rm -rf /tmp/certs

# Point Python HTTP libraries at the updated system cert bundle (runtime calls).
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Tell pip to trust PyPI hosts explicitly — works even when the proxy does SSL
# inspection and the cert chain can't be fully resolved at build time.
ENV PIP_TRUSTED_HOST="pypi.org pypi.python.org files.pythonhosted.org"

COPY backend/requirements.txt ./
COPY pip-cache/ /tmp/pip-cache/

RUN if [ "$(ls /tmp/pip-cache/*.whl /tmp/pip-cache/*.tar.gz 2>/dev/null)" ]; then \
      pip install --no-cache-dir --no-index --find-links /tmp/pip-cache -r requirements.txt; \
    else \
      pip install --no-cache-dir \
        --trusted-host pypi.org \
        --trusted-host pypi.python.org \
        --trusted-host files.pythonhosted.org \
        -r requirements.txt; \
    fi && rm -rf /tmp/pip-cache

COPY backend/ ./
COPY --from=frontend-build /frontend/dist ./static

RUN mkdir -p uploads

ENV STATIC_DIR=/app/static
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "37100"]
