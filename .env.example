# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── LLM judge ────────────────────────────────────────────────────────────────

# Provider: ollama (on-prem, default) | openai (testing only)
LLM_PROVIDER=ollama

# Ollama runs on the HOST machine outside Docker.
# host.docker.internal is mapped to the host automatically via extra_hosts.
# If Ollama runs on a separate GPU server, put that server's IP here.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Only used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Deployment: reverse proxy sub-path ───────────────────────────────────────
# Scenario A — direct access (no reverse proxy):
#   Users hit http://<server-ip>:37100 directly.
#   Leave VITE_BASE_PATH unset (defaults to /).
#
# Scenario B — behind a reverse proxy with a sub-path:
#   Reverse proxy exposes the app at e.g. http://proxy-host/ragas/
#   and strips the prefix before forwarding to this container.
#   Set VITE_BASE_PATH to that prefix AT BUILD TIME so the frontend
#   knows where its assets and API calls live.
#   Example:
#     VITE_BASE_PATH=/lens-ragas-web make prod-up
#
# VITE_BASE_PATH=/lens-ragas-web
